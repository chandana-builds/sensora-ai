# ===== Sensora AI Frontend — Local Supabase & Mailpit Development =====
# Copy this file to frontend/.env.local to test locally with Supabase CLI and Mailpit.
# Vite automatically prioritizes .env.local over .env without altering production configs.

VITE_API_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000

# Local Supabase API Gateway (CLI default)
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Local Supabase Publishable Anon Key (run `npx supabase status` to verify)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM0MTI4MDB9.CRX1A_placeholder_run_npx_supabase_status_to_get_key

# Optional: Local Mailpit/Inbucket Inbox URL (for convenient UI quicklinks)
VITE_LOCAL_MAILPIT_URL=http://127.0.0.1:54324
