# ===== Backend (Render dashboard or backend/.env). Never commit a real .env. =====
ENV=development                      # production on Render
ALLOWED_ORIGINS=http://localhost:5173   # production: exact https origin of the Vercel app
ALLOW_ANONYMOUS_DEMO=true            # guest access (signed tokens). Production default is false
APP_SECRET=change-me-to-a-random-string-of-32+-characters   # python -c "import secrets;print(secrets.token_urlsafe(48))"
STORAGE_BACKEND=sqlite               # sqlite (local) | supabase (production)
SQLITE_PATH=sensora_dev.db
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # server-only
AI_MODE=auto                         # auto | real | demo
# Multi-Provider AI Reliability Configuration
AI_PROVIDER_ORDER=meta,gemini,groq       # Comma-separated order of preference
AI_MAX_RETRIES=2                         # Max exponential backoff attempts for transient errors
AI_COOLDOWN_SECONDS=60                   # Health cooldown window when circuit breaker trips

# Primary Provider: Meta Model API
MODEL_API_KEY=                           # Meta Model API key (server-only)
META_API_BASE=https://api.meta.ai/v1
META_REASONING_MODEL=muse-spark-1.3
META_VISION_MODEL=muse-spark-1.3
META_STT_MODEL=muse-voice-transcribe-1.0
META_STT_LANGUAGE_BIAS=English
META_TIMEOUT_S=45
META_USE_JSON_SCHEMA=false

# Fallback Provider: Google Gemini API (Multimodal Reasoning & Vision)
GEMINI_API_KEY=                          # Google Gemini API key (server-only)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-1.5-flash

# Fallback Provider: Groq API (High-speed STT, Vision, and Reasoning)
GROQ_API_KEY=                            # Groq API key (server-only)
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_REASONING_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_STT_MODEL=whisper-large-v3

DEMO_SCENARIO=router                     # router | induction
RATE_LIMIT_PER_MIN=120
EXPENSIVE_LIMIT_PER_MIN=20
MAX_TURNS_PER_DAY=100
MAX_BODY_BYTES=8388608
MAX_SESSIONS_PER_USER=200
MAX_MESSAGES_PER_SESSION=500
EVIDENCE_RETENTION_DAYS=30
