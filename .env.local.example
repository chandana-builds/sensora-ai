# ===== Sensora AI — Unified Local Supabase & Mailpit Development =====
# Copy to .env to test entire stack locally with Docker, Supabase CLI, and Mailpit.

ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_ANONYMOUS_DEMO=true
APP_SECRET=sensora-super-secret-key-32-chars-long-minimum-jwt-secret-m4

STORAGE_BACKEND=sqlite               # sqlite (local file) | supabase (local PostgREST)
SQLITE_PATH=sensora_dev.db

# Local Supabase Endpoints (from `npx supabase status`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM0MTI4MDB9.CRX1A_placeholder_run_npx_supabase_status_to_get_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzQxMjgwMH0.EGIM_placeholder_run_npx_supabase_status_to_get_key

# AI Configuration
AI_MODE=demo                         # auto | real | demo
DEMO_SCENARIO=router
RATE_LIMIT_PER_MIN=120
EXPENSIVE_LIMIT_PER_MIN=20
MAX_TURNS_PER_DAY=100
MAX_BODY_BYTES=8388608
MAX_SESSIONS_PER_USER=200
MAX_MESSAGES_PER_SESSION=500
EVIDENCE_RETENTION_DAYS=30

# Frontend Variables
VITE_API_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM0MTI4MDB9.CRX1A_placeholder_run_npx_supabase_status_to_get_key
VITE_LOCAL_MAILPIT_URL=http://127.0.0.1:54324
